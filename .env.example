# ===================================================================
# ARQUIVO DE EXEMPLO: .env.example
# ===================================================================
# Copie este arquivo como ".env" na raiz do projeto e customize
# as variáveis conforme necessário para seu ambiente
#
# Comando para copiar:
#   cp .env.example .env  (Linux/Mac)
#   copy .env.example .env (Windows)
# ===================================================================

# ===== URLs =====
# URL do site RPA Challenge
# Padrão: https://rpachallenge.com/
RPA_CHALLENGE_URL=https://rpachallenge.com/

# ===== PATHS (Diretórios) =====
# Caminho onde os arquivos serão baixados
# Padrão: ./downloads
Caminho_Pasta_Downloads=./downloads/teste

# Caminho onde as evidências (screenshots) serão salvos
# Padrão: ./logs
caminho_evidencias=./logs

# ===== BROWSER CONFIGURATION =====
# Ambiente de execução: local, docker, ou remote
# - local: Selenium em máquina local
# - docker: Selenium em container Docker (usar docker-compose.yml)
# - remote: Selenium em cloud/servidor remoto
# Padrão: local
Environment=docker

# Browser: chrome ou firefox
# Padrão: chrome
Browser=chrome

# URL do Selenium Hub (para docker e remote)
# Local: http://localhost:4444
# Docker: http://selenium-hub:4444/wd/hub
# Cloud: URL fornecido pelo provedor
# Padrão: http://selenium-hub:4444/wd/hub
Remote_Url=http://localhost:4444

# ===== FILES =====
# Nome do arquivo Excel baixado do site
# Padrão: challenge.xlsx
Excel_File_Name=challenge.xlsx

# ===== TIMEOUTS (em segundos) =====
# Tempo de espera padrão para elementos aparecerem
# Padrão: 60
Default_Wait_Time=60

# Tempo de espera para download de arquivos
# Padrão: 5
File_Download_Wait=5

# ===== XPATHS (Elementos da página) =====
# Os XPaths abaixo são valores padrão
# Descomente e modifique se os XPaths mudarem no site
#
# Formato: XPATH_<nome_do_elemento>=<xpath>
#
# Exemplos de modificação:

# XPath do botão de download
# XPATH_download_button=/html/body/app-root/div[2]/app-rpa1/div/div[1]/div[6]/a

# XPath do botão de iniciar/começar
# XPATH_start_button=/html/body/app-root/div[2]/app-rpa1/div/div[1]/div[6]/button

# XPath do campo "First Name"
# XPATH_first_name=//rpa1-field[contains(@ng-reflect-dictionary-value, "First Name")]/div/input

# XPath do campo "Last Name"
# XPATH_last_name=//rpa1-field[contains(@ng-reflect-dictionary-value, "Last Name")]/div/input

# XPath do campo "Email"
# XPATH_email=//rpa1-field[contains(@ng-reflect-dictionary-value, "Email")]/div/input

# XPath do campo "Address"
# XPATH_address=//rpa1-field[contains(@ng-reflect-dictionary-value, "Address")]/div/input

# XPath do campo "Phone Number"
# XPATH_phone_number=//rpa1-field[contains(@ng-reflect-dictionary-value, "Phone Number")]/div/input

# XPath do campo "Company Name"
# XPATH_company_name=//rpa1-field[contains(@ng-reflect-dictionary-value, "Company Name")]/div/input

# XPath do campo "Role in Company"
# XPATH_role_in_company=//rpa1-field[contains(@ng-reflect-dictionary-value, "Role in Company")]/div/input

# XPath do botão de enviar/submit
# XPATH_submit_button=//input[contains(@type, 'submit')]

# ===================================================================
# EXEMPLOS DE CONFIGURAÇÃO POR AMBIENTE
# ===================================================================

# ===== AMBIENTE LOCAL =====
# Environment=local
# Browser=chrome
# Remote_Url=http://localhost:4444
# Caminho_Pasta_Downloads=./downloads
# caminho_evidencias=./logs

# ===== AMBIENTE DOCKER =====
# Environment=docker
# Browser=chrome
# Remote_Url=http://selenium-hub:4444/wd/hub
# Caminho_Pasta_Downloads=./downloads/teste
# caminho_evidencias=./logs

# ===== AMBIENTE REMOTE/CLOUD =====
# Environment=remote
# Browser=chrome
# Remote_Url=https://seu-provider-cloud.com/wd/hub
# Caminho_Pasta_Downloads=./downloads
# caminho_evidencias=./logs

# ===================================================================
# NOTAS IMPORTANTES
# ===================================================================
# 1. O arquivo .env é carregado automaticamente por python-dotenv
# 2. Nunca commit o .env em repositórios - é arquivo local
# 3. Use .env.example como referência para novos ambientes
# 4. Variáveis não definidas usarão valores padrão do config.py
# 5. Variáveis de ambiente do SO sobrescrevem o .env
# 6. Para usar docker, execute: docker-compose up -d
# 7. Para verificar variáveis carregadas, execute: python -c "from config.config import config; print(config.__dict__)"
